---
// Лендинг библиотеки: без JS-островов, только разметка и токены кита.
import Base from "../layouts/Base.astro";

const players = [
  "Карлсен", "Накамура", "Каспаров", "Крамник", "Анд", "Топалов", "Аронян",
  "Каруана", "Гири", "Со", "Мамедьяров", "Вашье-Лаграв", "Непомнящий",
  "Дин Лижэнь", "Фируджа", "Раджабов", "Грищук", "Свидлер", "Широв",
  "Иванчук", "Гельфанд", "Леко", "Адамс", "Морозевич",
];
---

<Base
  title="Библиотека партий — Take the Space"
  description="115 000 партий элитных гроссмейстеров: мгновенный поиск по игрокам, доска lichess, автоплей, генеративная lofi-музыка."
>
  <div class="mx-auto max-w-[620px] px-5">
    <section class="grid gap-5 py-12">
      <span class="section-title">Take the Space / chess library</span>
      <h1 class="font-display text-4xl leading-tight">
        Мегабаза партий: 115 142 партии элиты, под lofi.
      </h1>
      <p class="text-muted">
        Все партии Карлсена, Каспарова, Морозевича, Накамуры и ещё двух десятков
        сильнейших шахматистов планеты — в одном месте. Печатаете «Морозевич» —
        получаете все его партии. Выбираете — доска просыпается и показывает.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href="/app">Открыть библиотеку</a>
      </div>
    </section>

    <section class="m-reveal grid gap-3 border-t border-line py-10">
      <span class="section-title">В базе</span>
      <p class="text-sm text-muted leading-relaxed">
        {players.join(" · ")}
      </p>
    </section>

    <section class="m-reveal grid gap-3 border-t border-line py-10">
      <span class="section-title">Как это работает</span>
      <p class="text-sm text-muted">
        Индекс метаданных живёт на Cloudflare Workers — поиск мгновенный и работает
        офлайн после первого визита (кеш в браузере). Тела партий хранит спящий
        Sailbox, который просыпается по запросу за пару секунд — так библиотека
        ничего не стоит, пока её не читают. Доска — open-source chessground (как на
        lichess), ходы считает chessops. Музыка — генеративный lofi на WebAudio,
        без внешних файлов. Навигация — стрелки, автоплей — пробел, музыка — M.
      </p>
    </section>

    <footer class="border-t border-line py-8">
      <p class="text-xs text-faint">
        Chessground BSD-2-Clause (lichess.org), piece art by Colin M.L. Burnett.
        Chessops GPL-3.0-or-later. Источник партий — pgnmentor.com (свободно
        распространяемые файлы игроков). App code: Take the Space, GPLv3.
      </p>
    </footer>
  </div>
</Base>
