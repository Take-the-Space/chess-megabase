// Cloudflare Workers: статика Astro-сборки (приложение целиком клиентское).
// Деплой: wrangler deploy (локально или из GitHub Actions на push в main).
{
  "name": "tts-chess-starter",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
