{
  "name": "chess-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm --filter @chess-starter/web build",
    "dev:web": "pnpm --filter @chess-starter/web dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.42.0"
  }
}